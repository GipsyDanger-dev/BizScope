# PostgreSQL database with the pgvector extension enabled.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bizscope"

# Server-side only. Do not prefix either key with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=""
GEMINI_API_KEY=""

# Google OAuth. Add http://localhost:3000/api/auth/callback/google as an
# authorized redirect URI in Google Cloud Console during local development.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
